alert icmp any any -> $HOME_NET any (msg:"LAB ICMP echo request"; itype:8; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB Possible port scan (many SYN)"; flags:S; threshold:type both, track by_src, count 20, seconds 5; sid:1000002; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB SQL injection UNION SELECT"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; sid:1000003; rev:1;)